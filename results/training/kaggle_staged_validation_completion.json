  "calculation_source": "import json\nimport shutil\nfrom pathlib import Path\nfrom makemarket.provenance import file_sha256, receipt\n\nsource = Path('runs/kaggle_validation_output')\nout = Path('results/kaggle/staged-validation-v1')\nshutil.copytree(source,out,dirs_exist_ok=True)\nfiles = {str(p):file_sha256(p) for p in sorted(out.rglob('*')) if p.is_file()}\ncohorts = {}\nfor path in out.rglob('*.jsonl'):\n rows=[json.loads(line) for line in path.read_text().splitlines()]\n assert sorted(r['seed'] for r in rows)==list(range(80000,80100))\n assert all(len(r['rounds'])==6 for r in rows)\n cohorts[str(path)]={'episodes':len(rows),'sha256':files[str(path)]}\npair=json.loads((out/'pair_runtime.json').read_text())\nassert pair['exit_codes']==[0,0]\nr={'provenance':receipt({'purpose':'retain complete staged GPU validation'},pair['model_revision']),\n   'kernel':'nicolascoquelet/makemarketbench-grpo-qwen3-validate-staged','version':1,\n   'download_receipt':'results/training/kaggle_staged_validation.json',\n   'runtime_file':str(out/'pair_runtime.json'),'cohorts':cohorts,'files_sha256':files,\n   'interpretation':'Validation only; no held-out scores inspected or selected here.',\n   'calculation_source':Path(__file__).read_text()}\nPath('results/training/kaggle_staged_validation_completion.json').write_text(json.dumps(r,indent=2)+'\\n')\np=Path('results/training/kaggle_budget.json');b=json.loads(p.read_text())\nfor session in b['sessions']:\n if session['kernel']==r['kernel']:\n  session.update(status='completed_outputs_retrieved',version=1,script_wall_seconds=pair['wall_seconds'],\n                 observed_complete_at=json.loads(Path(r['download_receipt']).read_text())['polls'][-1]['at'],\n                 result_file=r['runtime_file'],allocation_end_at=None,\n                 allocation_end_note='Exact release time unavailable; observed completion is an upper bound.')\np.write_text(json.dumps(b,indent=2)+'\\n')\np=Path('README.md');s=p.read_text().replace('It saved both adapters before separate Kaggle evaluations; policy quality is\\npending.', 'It saved both adapters before separate Kaggle evaluations. In the completed\\n100-episode validation cohorts, SFT performs better on dice and GRPO on cards\\n([all raw validation results](results/training/kaggle_staged_validation_completion.json));\\nheld-out policy quality remains pending.');p.write_text(s)\n"
