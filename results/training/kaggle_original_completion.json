  "calculation_source": "import json\nimport shutil\nfrom pathlib import Path\nfrom makemarket.provenance import receipt, file_sha256\n\nsource=Path('runs/kaggle_original_output')\ndest=Path('results/kaggle/original-v1')\nfiles=[]\nfor path in source.rglob('*'):\n if path.is_file() and path.name not in ('tokenizer.json','tokenizer_config.json','README.md'):\n  target=dest/path.relative_to(source)\n  target.parent.mkdir(parents=True,exist_ok=True)\n  shutil.copyfile(path,target)\n  files.append(str(target))\ncohorts={}\nfor path in (dest/'results/raw').rglob('*.jsonl'):\n rows=[json.loads(s) for s in path.read_text().splitlines()]\n seeds=sorted(r['seed'] for r in rows)\n assert len(seeds)==len(set(seeds)) and all(len(r['rounds'])==6 for r in rows)\n cohorts[str(path)]={'episodes':len(rows),'seeds':seeds,'complete_200_399':seeds==list(range(200,400))}\nlogs=json.loads((dest/'makemarketbench-grpo-qwen3.log').read_text())\ntraining=[]\nfor line in logs:\n data=line['data']\n if 'train_runtime' in data or '[eval]' in data:\n  if '[eval]' in data:\n   import re\n   match=re.search(r'\\[eval\\] (\\w+): (\\d+) episodes.*\\((\\d+)s\\)',data)\n   if match: training.append({'script_log_seconds':line['time'],'game':match[1],'episodes':int(match[2]),'reported_evaluation_seconds':int(match[3])})\n  else:\n   training.append({'script_log_seconds':line['time'],'trainer_summary':data.strip()})\nr={'provenance':receipt({'purpose':'retain platform-limited original run without aggregate test inspection'},'3764fa359b9082ea5a1e4a5e3ac3aaf6e9671636'),\n   'kernel':'nicolascoquelet/makemarketbench-grpo-qwen3','version':1,\n   'submission_receipt':'results/training/kaggle_retry.json',\n   'terminal_status':'KernelWorkerStatus.CANCEL_ACKNOWLEDGED',\n   'sft_updates':150,'grpo_updates':json.loads((dest/'grpo/checkpoint-300/trainer_state.json').read_text())['global_step'],\n   'runtime_receipt_missing':True,'runtime_note':'Platform termination prevents the original finally block from writing 