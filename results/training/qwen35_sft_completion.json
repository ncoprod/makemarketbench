  "source": "import json\nfrom pathlib import Path\n\nfrom makemarket.provenance import file_sha256, receipt\n\ntraining = Path('results/training/qwen35_sft.json')\nguard = Path('results/training/qwen35_sft_memory.json')\nr, g = json.loads(training.read_text()), json.loads(guard.read_text())\nassert r['status'] == g['status'] == 'completed'\nassert r['completed_iterations'] == 800 and r['optimizer_updates'] == 400\nassert any(v['iteration'] == 799 for v in r['validation'])\nbest = Path('train/runs/qwen3.5-4b-sft/best.safetensors')\nadapter = Path('train/runs/qwen3.5-4b-sft/adapters.safetensors')\nassert file_sha256(best) == file_sha256(adapter)\nrecord = {'provenance': receipt({'purpose': 'retain the completed uniform-shape local Qwen3.5 SFT run before policy validation'}, r['model_revision']),\n          'source': Path(__file__).read_text(), 'training_file': str(training), 'memory_guard_file': str(guard),\n          'input_sha256': {str(p):file_sha256(p) for p in (training, guard)},\n          'training_snapshot': r, 'memory_guard_snapshot': g, 'selected_adapter_sha256': file_sha256(adapter),\n          'interpretation': 'Completed 800 consumed microbatches, 400 optimizer updates, full 480-example validation. Warm start from the recorded interrupted adapter with a restarted optimizer; not a fresh-from-base seed replicate. Policy validation follows; no PnL inferred from teacher loss.'}\nPath('results/training/qwen35_sft_completion.json').write_text(json.dumps(record, indent=2) + '\\n')\nprint(json.dumps({'status':r['status'],'microbatches':r['completed_iterations'],'optimizer_updates':r['optimizer_updates'],\n                  'wall_seconds':r['wall_seconds'],'best_validation_loss':r['best_validation_loss'],'best_step':r['best_step'],\n                  'last_validation':r['validation'][-1],'sampled_physical_peak_bytes':g['sampled_footprint_peak_bytes_approx']}))\n",
