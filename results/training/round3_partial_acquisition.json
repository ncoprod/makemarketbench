  "source": "import json\nfrom pathlib import Path\nfrom makemarket.games import make_game\nfrom makemarket.provenance import file_sha256,receipt\n\nroot=Path('results/kaggle/qwen38-seed1-sft-validation-v1')\ncounts={}\nfor p in root.rglob('*.jsonl'):\n rows=[json.loads(s) for s in p.read_text().splitlines()]\n assert [r['seed'] for r in rows]==list(range(80000,80000+len(rows)))\n for row in rows:\n  canonical=make_game(row['game']).episode(row['seed'])\n  assert len(row['rounds'])==6 and row['value']==canonical.value\n  assert [r['reveal'] for r in row['rounds']]==canonical.reveals\n counts[str(p)]={'episodes':len(rows),'sha256':file_sha256(p)}\npair=json.loads((root/'pair_runtime.json').read_text())\nrecord={'provenance':receipt({'purpose':'retain bounded validation timeout and incomplete thinking API cohorts without partial-game scores'}),\n        'source':Path(__file__).read_text(),'validation':{'status':'partial_at_wall_cap','cohorts':counts,'wall_seconds':pair['wall_seconds'],\n        'runtime_sha256':file_sha256(root/'pair_runtime.json'),'error':'TimeoutError: Registered training wall budget exhausted',\n        'diagnosis':'Downloaded Unsloth log warns of remaining bfloat16 layers on T4s without native bfloat16. A training-state FP32 profile will test this bottleneck; no speedup is assumed.'},'ultra_thinking':{}}\nprotocol=Path('results/expansion/protocol-ultra-medium.json');entry=next(iter(json.loads(protocol.read_text()).values()))\nfor game,n in [('dice',53),('cards',74)]:\n p=Path(f'results/expansion/raw/{game}/nvidia_nemotron-3-ultra-550b-a55b__thinking-medium_.jsonl')\n rows=[json.loads(s) for s in p.read_text().splitlines()]\n assert [r['seed'] for r in rows]==list(range(200,200+n))\n for row in rows:\n  canonical=make_game(game).episode(row['seed'])\n  assert len(row['rounds'])==6 and row['value']==canonical.value\n  assert [r['reveal'] for r in row['rounds']]==canonical.reveals\n record['ultra_thinking'][game]={'episodes':n,'raw_file':str(p),'raw_sha256':file_sha256(p),**entry[game]}\nrecord['scope']='Acquisition and canonical checks only. Incomplete cards validation and both incomplete API cohorts remain unscored. Original four API cohorts remain complete.'\nPath('results/training/round3_partial_acquisition.json').write_text(json.dumps(record,indent=2)+'\\n')\np=Path('results/training/kaggle_budget.json');ledger=json.loads(p.read_text());session=next(s for s in ledger['sessions'] if s['kernel'].endswith('seed-1-sft-validation'))\nsession.update(status='partial_at_wall_cap',hours=pair['wall_seconds']/3600,script_wall_seconds=pair['wall_seconds'],result_file=str(root/'pair_runtime.json'),hours_basis='Downloaded script runtime; exact allocation billing boundaries unavailable.')\np.write_text(json.dumps(ledger,indent=2)+'\\n')\nprint('Verified validation 100 dice / 4 cards; Ultra thinking 53 dice / 74 cards. Partial cohorts unscored.')\n",
