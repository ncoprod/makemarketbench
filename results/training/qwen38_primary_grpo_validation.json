  "source": "import json\nimport os\nimport re\nimport subprocess\nfrom datetime import datetime, timezone\nfrom pathlib import Path\nfrom makemarket.provenance import file_sha256, receipt\n\npath=Path('results/training/qwen38_primary_grpo_validation.json')\nassert not path.exists(), 'Inspect any existing submission before restarting'\ncompletion=Path('results/training/qwen38_seed0_completion.json')\nassert json.loads(completion.read_text())['status']=='completed_outputs_verified'\nfolder=Path('runs/kaggle_qwen38_primary_grpo_validate')\nmeta=json.loads((folder/'kernel-metadata.json').read_text())\nassert meta['is_private'] and meta['enable_internet'] and meta['enable_gpu']\nenv={**os.environ,'KAGGLE_CONFIG_DIR':str(Path('runs/kaggle_oauth_config').resolve())}\nfor name in ('KAGGLE_KEY','KAGGLE_API_TOKEN','KAGGLE_TOKEN_FILE'):\n    env.pop(name,None)\nsubprocess.run(['/Users/nico/.local/share/uv/tools/kaggle/bin/python','scripts/kaggle_quota.py'],env=env,check=True)\nsnapshot=json.loads(Path('results/training/kaggle_account_budget_snapshot.json').read_text())\nquota=snapshot['quota'];available=quota['gpu_seconds_total']-quota['gpu_seconds_used']-quota['gpu_seconds_reserved']\nother=json.loads(Path('results/training/qwen38_primary_sft_validation.json').read_text())\nremaining_other_cap=max(0,11100-(datetime.now(timezone.utc)-datetime.fromisoformat(other['submitted_at'])).total_seconds()) if other['status']=='submitted' else 0\nreserve=30600\ncommand=['kaggle','kernels','push','-p',str(folder),'--accelerator','NvidiaTeslaT4','--timeout','21600']\nrecord={'provenance':receipt({'purpose':'Primary GRPO validation; reserve 9000 seconds for missing SFT validation and 21600 for selected test'},'8aa5f05d26b7205477066e1449e0af13f762a299'),\n        'source':Path(__file__).read_text(),'completion_sha256':file_sha256(completion),\n        'profile_completion_sha256':file_sha256(Path('results/training/qwen38_compile_probe_completion.json')),\n        'metadata':meta,'source_sha256':file_sha256(folder/meta['code_file']),\n        'quota_snapshot':snapshot,'available_seconds':available,'remaining_primary_sft_validation_cap_seconds':remaining_other_cap,\n        'remaining_primary_evaluation_reserve_seconds':reserve,'session_timeout_seconds':21600,\n        'scope':'Registered primary GRPO validation, 100 episodes/game, seeds 80000-80099; unchanged native serial inference.',\n        'status':'admission_check','polls':[]}\nassert available>=remaining_other_cap+reserve+21600,'Insufficient quota after primary reserve'\nrecord.update(status='submitting',submitted_at=datetime.now(timezone.utc).isoformat())\npath.write_text(json.dumps(record,indent=2)+'\\n')\nresult=subprocess.run(command,env=env,capture_output=True,text=True)\nrecord['push']={'command':command,'exit_code':result.returncode,'output':result.stdout,'error':result.stderr}\nmatch=re.search(r'Kernel version (\\d+)',result.stdout)\nactual=re.search(r'https://www.kaggle.com/code/([^/\\s]+/[^/\\s]+)',result.stdout)\nif actual:\n    record['requested_kernel']=meta['id'];meta['id']=actual[1];record['metadata']=meta\nrecord.update(status='submitted' if result.returncode==0 and match else 'push_requires_inspection',version=int(match[1]) if match else None)\npath.write_text(json.dumps(record,indent=2)+'\\n')\nassert record['status']=='submitted','Inspect ambiguous submission before any retry'\np=Path('results/training/kaggle_budget.json');ledger=json.loads(p.read_text())\nledger['sessions'].append({'kernel':meta['id'],'version':record['version'],'accelerator':'T4 x2 requested',\n    'start':None,'end':None,'hours':None,'submitted_at':record['submitted_at'],'private':True,'status':'submitted',\n    'source_commit':record['provenance']['git_commit'],'receipt':str(path),'session_timeout_seconds':21600,\n    'purpose':'Primary GRPO96 validation on both games, native serial inference.',\n    'hours_basis':'Pending downloaded runtime; session cap is not measured usage.'})\np.write_text(json.dumps(ledger,indent=2)+'\\n')\nprint('Submitted',meta['id'],'version',record['version'],flush=True)\nsubprocess.run(['.venv/bin/python','-u','scripts/watch_kaggle.py','--receipt',str(path),'--out',\n                f\"results/kaggle/qwen38-primary-grpo-validation-v{record['version']}\"],check=True)\n",
