  "source": "import json\nfrom pathlib import Path\nfrom urllib.request import urlopen\n\nfrom makemarket.provenance import receipt\n\nurls = {\n    'latest_created': 'https://huggingface.co/api/models?author=Qwen&sort=createdAt&direction=-1&limit=60',\n    'qwen38_family': 'https://huggingface.co/api/models?author=Qwen&search=Qwen3.8&limit=100&full=true',\n}\nrecord = {'provenance': receipt({'purpose': 'refresh official Qwen release catalogue after the UTC date change', 'urls': urls}),\n          'source': Path(__file__).read_text(), 'responses': {}}\nfields = ('id', 'sha', 'createdAt', 'lastModified', 'pipeline_tag', 'tags')\nfor name, url in urls.items():\n    with urlopen(url, timeout=45) as response:\n        rows = json.load(response)\n    record['responses'][name] = [{k: r[k] for k in fields if k in r} for r in rows]\nrecord['comparison_note'] = 'Primary catalogue refresh only; the full pinned model/weight/licence evidence remains in qwen_latest_details.json and qwen38_quantized.json. Do not infer policy quality from release recency.'\nPath('results/training/qwen_latest_recheck_20261031.json').write_text(json.dumps(record, indent=2) + '\\n')\nprint(json.dumps({name: [r['id'] for r in rows] for name, rows in record['responses'].items()}))\n",
