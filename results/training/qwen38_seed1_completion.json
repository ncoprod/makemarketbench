  "source": "import ast\nimport json\nimport sys\nfrom pathlib import Path\nfrom makemarket.provenance import file_sha256, receipt\nsys.path.insert(0, str(Path.cwd()))\nfrom train.qwen38_continue import latest_checkpoint\n\nroot, batch_path, seed = Path(sys.argv[1]), Path(sys.argv[2]), int(sys.argv[3])\nruntime = json.loads((root / 'runtime.json').read_text())\nbatch = json.loads(batch_path.read_text())\nassert batch['status'] == 'outputs_retrieved'\nassert runtime['status'] == 'completed' and runtime['seed'] == seed\nassert runtime['model_revision'] == '8aa5f05d26b7205477066e1449e0af13f762a299'\nassert runtime['phase'] == 'grpo' and runtime['phase_step'] == 96\nassert runtime['source_file_sha256'] == file_sha256(root / 'train_core.py')\nplan = json.loads(Path('results/training/qwen38_seed1_plan.json' if seed else 'results/training/qwen38_round3_batch_plan.json').read_text())\nsource = Path('runs/kaggle_qwen38_seed1/grpo_unsloth_kaggle.py' if seed else 'runs/kaggle_qwen38_train/grpo_unsloth_kaggle.py')\nexpected_core = next(ast.literal_eval(n.value.args[0]) for n in ast.walk(ast.parse(source.read_text()))\n                     if isinstance(n, ast.Expr) and isinstance(n.value, ast.Call)\n                     and isinstance(n.value.func, ast.Attribute) and n.value.func.attr == 'write_text')\nassert (root / 'train_core.py').read_text() == expected_core\nsft, grpo = latest_checkpoint(root / 'sft'), latest_checkpoint(root / 'grpo')\nassert sft is not None and grpo is not None\nsft_state, grpo_state = [json.loads((p / 'trainer_state.json').read_text()) for p in (sft, grpo)]\nassert grpo_state['global_step'] == 96\nbest = root / 'sft' / Path(sft_state['best_model_checkpoint']).name\nassert file_sha256(best / 'adapter_model.safetensors') == file_sha256(root / 'warmstart_adapter/adapter_model.safetensors')\nassert file_sha256(grpo / 'adapter_model.safetensors') == file_sha256(root / 'lora_adapter/adapter_model.safetensors')\ninventory = {str(p): {'sha256': file_sha256(p), 'bytes': p.stat().st_size} for p in sorted(root.rglob('*')) if p.is_file()}\nrecord = {'provenance': receipt({'root': str(root), 'batch': str(batch_path), 'seed': seed}, runtime['model_revision']),\n          'source': Path(__file__).read_text(), 'status': 'completed_outputs_verified', 'seed': seed,\n          'runtime_file': str(root / 'runtime.json'), 'batch_sha256': file_sha256(batch_path),\n          'sft_updates': sft_state['global_step'], 'best_sft_step': sft_state['best_global_step'],\n          'best_sft_validation_loss': sft_state['best_metric'], 'grpo_updates': grpo_state['global_step'],\n          'sft_early_stopping': sft_state['stateful_callbacks'].get('EarlyStoppingCallback'),\n          'wall_seconds': runtime['wall_seconds'], 'memory_by_gpu': runtime['memory_by_gpu'],\n          'latest_complete_checkpoint_per_phase_verified': True, 'downloaded_files': inventory,\n          'scope': 'Training and artifact identity only. No policy evaluation score or held-out aggregate is opened.'}\nPath(f'results/training/qwen38_seed{seed}_completion.json').write_text(json.dumps(record, indent=2) + '\\n')\np=Path('results/training/kaggle_budget.json');ledger=json.loads(p.read_text())\nsession=next(s for s in ledger['sessions'] if s['kernel']==batch['metadata']['id'] and s['version']==batch['version'])\nsession.update(status='completed_outputs_verified', script_started_at=runtime['execution_started_at'],\n               script_finished_at=runtime['execution_finished_at'], script_wall_seconds=runtime['wall_seconds'],\n               hours=runtime['wall_seconds']/3600, result_file=str(root/'runtime.json'),\n               hours_basis='Downloaded script runtime, including installation and loading. Exact allocation billing boundaries are unavailable.')\np.write_text(json.dumps(ledger,indent=2)+'\\n')\nprint({k:record[k] for k in ('status','seed','sft_updates','best_sft_step','grpo_updates','wall_seconds')})\n",
