  "source": "import ast\nimport json\nfrom pathlib import Path\nfrom makemarket.games import make_game\nfrom makemarket.provenance import file_sha256,receipt\n\npath=Path('results/training/qwen38_b4_validation_completion.json');assert not path.exists()\nroot=Path('results/kaggle/qwen38-b4-validation-v1')\nlaunch=json.loads(Path('results/training/qwen38_b4_validation.json').read_text());assert launch['status']=='outputs_retrieved'\nsource=Path('runs/kaggle_qwen38_b4_validation/grpo_unsloth_kaggle.py');assert file_sha256(source)==launch['source_sha256']\ncore=next(n.args[0].value for n in ast.walk(ast.parse(source.read_text())) if isinstance(n,ast.Call) and isinstance(n.func,ast.Attribute) and n.func.attr=='write_text' and isinstance(n.args[0],ast.Constant))\nassert (root/'evaluate_core.py').read_text()==core\ntraining=Path('results/kaggle/qwen38-round3-training-v5');pair=json.loads((root/'pair_runtime.json').read_text())\ncohorts={};runtimes={}\nfor method,directory in [('sft','warmstart_adapter'),('grpo','lora_adapter')]:\n    label=f'qwen3.8-27b-batch4-{method}';work=root/label\n    adapter_hash=file_sha256(training/directory/'adapter_model.safetensors')\n    runtime_path=work/'runtime.json'\n    runtimes[method]=json.loads(runtime_path.read_text()) if runtime_path.exists() else None\n    cohorts[method]={}\n    for game in ('dice','cards'):\n        raw=work/'results/raw'/game/f'{label}.jsonl'\n        rows=[json.loads(line) for line in raw.read_text().splitlines()] if raw.exists() else []\n        assert [row['seed'] for row in rows]==list(range(80000,80000+len(rows)))\n        assert len(rows)%4==0\n        for row in rows:\n            assert row['player']==label and row['game']==game\n            canonical=make_game(game).episode(row['seed'])\n            assert row['value']==canonical.value and len(row['rounds'])==6\n            assert [r['reveal'] for r in row['rounds']]==canonical.reveals\n            cfg=row['provenance']['config']\n            assert cfg['seed']==0 and cfg['eval_batch_size']==4\n            assert cfg['revision']=='8aa5f05d26b7205477066e1449e0af13f762a299'\n            assert cfg['adapter_sha256']==adapter_hash\n        cohorts[method][game]={'episodes':len(rows),'complete':len(rows)==100,'canonical_games_verified':True,\n            'file':str(raw),'sha256':file_sha256(raw) if raw.exists() else None,'adapter_sha256':adapter_hash}\nrecord={'provenance':receipt({'purpose':'retain distinct batch-four primary SFT/GRPO validation, including any bounded partials'},'8aa5f05d26b7205477066e1449e0af13f762a299'),\n    'source':Path(__file__).read_text(),'status':'complete' if all(c['complete'] for games in cohorts.values() for c in games.values()) else 'partial_validation_retained',\n    'pair_runtime':pair,'runtimes':runtimes,'cohorts':cohorts,\n    'downloaded_files':{str(p):{'sha256':file_sha256(p),'bytes':p.stat().st_size} for p in root.rglob('*') if p.is_file()},\n    'scope':'Validation only; no incomplete game is scored and no held-out aggregate opened. Freeze only with both complete 100/game candidates.'}\npath.write_text(json.dumps(record,indent=2)+'\\n')\np=Path('results/training/kaggle_budget.json');ledger=json.loads(p.read_text());session=next(s for s in ledger['sessions'] if s['kernel']==launch['metadata']['id'] and s['version']==launch['version'])\nsession.update(status=record['status'],hours=pair['wall_seconds']/3600,script_wall_seconds=pair['wall_seconds'],result_file=str(root/'pair_runtime.json'),hours_basis='Downloaded complete wrapper wall runtime. Exact allocation billing boundaries and wrapper UTC boundaries unavailable.')\np.write_text(json.dumps(ledger,indent=2)+'\\n');print('Retained batch-four validation', {m:{g:c['episodes'] for g,c in games.items()} for m,games in cohorts.items()},flush=True)\n",
