  "source": "import json\nimport shutil\nfrom pathlib import Path\n\nfrom makemarket.provenance import file_sha256, receipt\n\nsource = Path('runs/kaggle_staged_sft_complete_output')\nout = Path('results/kaggle/staged-sft-complete-v1')\npull = Path('results/training/kaggle_staged_sft_complete.json')\ndownload = json.loads(pull.read_text())\nassert download['version'] == 1 and download['status'] == 'outputs_retrieved'\npair = json.loads((source / 'pair_runtime.json').read_text())\ninputs, cohorts, prefixes = {}, {}, {}\nfor src in source.rglob('*'):\n    if src.is_file() and src.suffix != '.jsonl':\n        dst = out / src.relative_to(source)\n        dst.parent.mkdir(parents=True, exist_ok=True)\n        shutil.copyfile(src, dst)\n        inputs[str(src)] = file_sha256(src)\nfor game in ('dice', 'cards'):\n    for label in ('qwen3.5-4b-staged-sft', 'bayes'):\n        parts = []\n        for seed in (200, 300):\n            raw = source / f'shard-{seed}/results/raw/{game}/{label}.jsonl'\n            if not raw.exists():\n                continue\n            rows = [json.loads(line) for line in raw.read_text().splitlines()]\n            assert [r['seed'] for r in rows] == list(range(seed, seed + len(rows)))\n            assert all(r['game'] == game and r['player'] == label and len(r['rounds']) == 6 for r in rows)\n            if label != 'bayes':\n                assert all(r['provenance']['model_revision'] == pair['model_revision'] for r in rows)\n                assert all(r['provenance']['config']['adapter_sha256'] == pair['adapter_sha256'] for r in rows)\n            if game == 'dice' and label != 'bayes':\n                old = Path(f'results/kaggle/staged-sft-serial-v2/shard-{seed}/results/raw/dice/{label}.jsonl')\n                assert raw.read_bytes().startswith(old.read_bytes())\n                prefixes[str(old)] = {'sha256': file_sha256(old), 'bytes_preserved': True}\n            inputs[str(raw)] = file_sha256(raw)\n            parts.append(raw.read_bytes())\n        if parts:\n            dst = out / f'qwen3.5-4b-staged-sft/results/raw/{game}/{label}.jsonl'\n            dst.parent.mkdir(parents=True, exist_ok=True)\n            dst.write_bytes(b''.join(parts))\n            rows = [json.loads(line) for line in dst.read_text().splitlines()]\n            seeds = [r['seed'] for r in rows]\n            assert len(seeds) == len(set(seeds))\n            cohorts[str(dst)] = {'episodes': len(rows), 'complete': sorted(seeds) == list(range(200, 400)),\n                                 'missing_seeds': sorted(set(range(200, 400)) - set(seeds)), 'sha256': file_sha256(dst)}\nr = {'provenance': receipt({'purpose': 'retain frozen missing-only SFT completion and cards parity outcome without scoring'}, pair['model_revision']),\n     'download_receipt': str(pull), 'kernel': download['metadata']['id'], 'version': 1,\n     'pair_runtime': pair, 'input_sha256': inputs, 'cohorts': cohorts, 'retained_dice_prefixes': prefixes,\n     'output_sha256': {str(p): file_sha256(p) for p in out.rglob('*') if p.is_file()},\n     'source': Path(__file__).read_text(), 'interpretation': 'Only cohort completeness, metadata and byte preservation checked; held-out scores remain sealed.'}\nPath('results/training/kaggle_staged_sft_complete_completion.json').write_text(json.dumps(r, indent=2) + '\\n')\np = Path('results/training/kaggle_budget.json')\nledger = json.loads(p.read_text())\nfor session in ledger['sessions']:\n    if session['kernel'] == r['kernel'] and session['version'] == 1:\n        session.update(status='completed_outputs_retrieved' if pair['exit_codes'] == [0, 0] else 'partial_outputs_retrieved',\n                       script_wall_seconds=pair['wall_seconds'], hours=pair['wall_seconds'] / 3600,\n                       hours_basis='Downloaded script runtime; exact allocation billing boundaries unavailable.',\n                       observed_complete_at=download['polls'][-1]['at'], result_file=str(out / 'pair_runtime.json'))\np.write_text(json.dumps(ledger, indent=2) + '\\n')\nprint(json.dumps({Path(k).name + ':' + Path(k).parent.name: {'episodes': v['episodes'], 'complete': v['complete']} for k,v in cohorts.items()}))\n",
  "interpretation": "Only cohort completeness, metadata and byte preservation checked; held-out scores remain sealed."
}
