  "source": "import hashlib\nimport json\nfrom pathlib import Path\n\nfrom makemarket.provenance import file_sha256, receipt\n\nroot = Path('results/expansion')\nplan = json.loads((root / 'intermittent_resume_plan.json').read_text())\nprotocol = json.loads((root / 'protocol-intermittent-resume.json').read_text())\nraw = root / 'raw/dice/nvidia_nemotron-3.5-bolt-e4b.jsonl'\nprefix = plan['existing_prefixes'][str(raw)]\nassert hashlib.sha256(raw.read_bytes()[:prefix['bytes']]).hexdigest() == prefix['sha256']\nrows = [json.loads(s) for s in raw.read_text().splitlines()]\nassert [r['seed'] for r in rows] == list(range(200, 400))\nfields = ('model','base_url','temperature','max_tokens','timeout','extra_body','label')\nconfigs = {json.dumps({k:r['provenance']['config'][k] for k in fields},sort_keys=True) for r in rows}\nassert len(configs) == 1\nr = {'provenance': receipt({'purpose': 'retain complete Bolt dice acquisition and bounded Llama-11B retry without opening scores'}, 'NIM immutable deployment revision not exposed'),\n     'source': Path(__file__).read_text(), 'episodes': len(rows), 'raw_file': str(raw), 'raw_sha256': file_sha256(raw),\n     'config':json.loads(configs.pop()), 'prior_138_episode_prefix_preserved':True,\n     'prefix':prefix,'completed_new_episodes':62,'resume':protocol['nvidia/nemotron-3.5-bolt-e4b']['dice'],\n     'llama11_bounded_retry': protocol['meta/llama-3.2-11b-vision-instruct (text-only)'],\n     'canonical_receipt': 'results/expansion/bolt_dice_complete_canonical.json',\n     'canonical_sha256': file_sha256(root/'bolt_dice_complete_canonical.json'),\n     'scope':'Acquisition only; no held-out aggregate opened. Bolt cards continue missing-only. Llama-11B remains incomplete after three 404 attempts on each game.'}\n(root/'bolt_dice_complete_cohort.json').write_text(json.dumps(r,indent=2)+'\\n')\nprint('Bolt dice 200 complete; exact 138-episode prefix preserved, settings identical; scores sealed.')\n",
