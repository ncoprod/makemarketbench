  "source": "import hashlib\nimport json\nfrom pathlib import Path\n\nfrom makemarket.provenance import file_sha256, receipt\n\nroot = Path('results/expansion')\nplan = json.loads((root / 'intermittent_resume_plan.json').read_text())\nprotocol = root / 'protocol-intermittent-resume.json'\nentry = json.loads(protocol.read_text())['nvidia/nemotron-3.5-bolt-e4b']\ngames = {}\nfor game in ('dice', 'cards'):\n    raw = root / 'raw' / game / 'nvidia_nemotron-3.5-bolt-e4b.jsonl'\n    data = raw.read_bytes()\n    prefix = plan['existing_prefixes'][str(raw)]\n    assert hashlib.sha256(data[:prefix['bytes']]).hexdigest() == prefix['sha256']\n    rows = [json.loads(line) for line in data.splitlines()]\n    assert [row['seed'] for row in rows] == list(range(200, 400))\n    fields = ('model', 'base_url', 'temperature', 'max_tokens', 'timeout', 'extra_body', 'label')\n    configs = {json.dumps({k: row['provenance']['config'][k] for k in fields}, sort_keys=True) for row in rows}\n    assert len(configs) == 1\n    games[game] = {'episodes': len(rows), 'raw_file': str(raw), 'raw_sha256': file_sha256(raw),\n                   'prefix': prefix, 'prefix_preserved': True,\n                   'new_episodes': len(rows) - data[:prefix['bytes']].count(b'\\n'),\n                   'config': json.loads(configs.pop()), 'resume': entry[game]}\nrecord = {'provenance': receipt({'purpose': 'retain complete Bolt acquisition without opening aggregate scores'}, 'NIM immutable deployment revision not exposed'),\n          'source': Path(__file__).read_text(), 'games': games,\n          'protocol_file': str(protocol), 'protocol_sha256': file_sha256(protocol),\n          'canonical_receipt': str(root / 'bolt_complete_canonical.json'),\n          'canonical_sha256': file_sha256(root / 'bolt_complete_canonical.json'),\n          'interpretation': 'Both original cached prefixes and decoder settings are preserved. All 200 common seeds per game pass canonical state checks. Earlier failures remain retained. Acquisition only: scores sealed until both policy selections are frozen.'}\n(root / 'bolt_complete_cohorts.json').write_text(json.dumps(record, indent=2) + '\\n')\nprint({g: {'episodes': r['episodes'], 'new_episodes': r['new_episodes']} for g, r in games.items()})\n",
