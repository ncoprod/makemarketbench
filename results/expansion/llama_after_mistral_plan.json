  "source": "import json\nimport subprocess\nfrom datetime import datetime, timezone\nfrom pathlib import Path\nfrom makemarket.provenance import file_sha256, receipt\n\nroot = Path('results/expansion')\nplan_path = root / 'llama_mistral_priority.json'\nplan = json.loads(plan_path.read_text())\nassert plan['status'] == 'paused_awaiting_mistral_finish'\nassert json.loads((root / 'mistral_budget_plan.json').read_text())['status'] == 'finished'\nprotocol_path = root / 'protocol-mistral-budget.json'\nprobes = json.loads(protocol_path.read_text())\nsummary = {}\nfor label, entry in probes.items():\n    response = entry.get('probe', {})\n    summary[label] = {k: entry[k] for k in ('usable', 'error', 'probe_wall_seconds', 'provenance') if k in entry}\n    summary[label]['response_metadata'] = {k: response.get(k) for k in ('finish_reason', 'completion_tokens', 'prompt_tokens', 'served_model', 'system_fingerprint', 'latency', 'cached')}\n    summary[label]['content_chars'] = len(response.get('content') or '')\n    summary[label]['reasoning_chars'] = len(response.get('reasoning') or '')\nraw = root / 'raw/dice/meta_llama-3.2-90b-vision-instruct__text-only_.jsonl'\nassert file_sha256(raw) == plan['raw_sha256']\nrecord = {'provenance': receipt({'purpose': 'retain bounded Mistral outcome and resume identical cached Llama cohort'}),\n          'source': Path(__file__).read_text(), 'mistral_probes': summary,\n          'mistral_protocol_sha256': file_sha256(protocol_path), 'command': plan['resume_command'],\n          'initial_dice_episodes': 24, 'initial_raw_sha256': file_sha256(raw),\n          'status': 'resuming_cached_prefix', 'started_at': datetime.now(timezone.utc).isoformat()}\npath = root / 'llama_after_mistral_plan.json'\nassert not path.exists()\npath.write_text(json.dumps(record, indent=2) + '\\n')\nplan.update(status='resuming_after_mistral_control', resume_receipt=str(path))\nplan_path.write_text(json.dumps(plan, indent=2) + '\\n')\nresult = subprocess.run(plan['resume_command'])\nrecord.update(status='finished', exit_code=result.returncode, finished_at=datetime.now(timezone.utc).isoformat())\npath.write_text(json.dumps(record, indent=2) + '\\n')\n",
