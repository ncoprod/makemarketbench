  "source": "import json\nimport time\nfrom pathlib import Path\n\nfrom makemarket.llm import ChatClient, LLMConfig, Throttle\nfrom makemarket.provenance import receipt\n\nclient = ChatClient(LLMConfig(model='discovery', timeout=60), throttle=Throttle(1))\nrecord = {'provenance': receipt({'method': 'GET /v1/models', 'purpose': 'fresh dated discovery of a possible Qwen3.8 API deployment'}),\n          'source': Path(__file__).read_text()}\ntry:\n    record['attempts'] = []\n    for attempt in range(3):\n        try:\n            record['data'] = client.client.models.list().model_dump()\n            break\n        except Exception as exc:\n            status = getattr(exc, 'status_code', None)\n            record['attempts'].append({'error_type': type(exc).__name__, 'http_status': status})\n            if attempt == 2 or (status is not None and status < 500 and status not in (408, 409, 429)):\n                raise\n            time.sleep(2 ** (attempt + 1))\n    ids = [r['id'] for r in record['data']['data']]\n    record.update(status='completed', count=len(ids), qwen_models=[s for s in ids if 'qwen' in s.lower()])\nexcept Exception as exc:\n    record.update(status='failed', error_type=type(exc).__name__, http_status=getattr(exc, 'status_code', None))\nPath('results/expansion/models_20261030.json').write_text(json.dumps(record, indent=2) + '\\n')\nprint(json.dumps({k: record[k] for k in ('status', 'count', 'qwen_models') if k in record}))\n",
