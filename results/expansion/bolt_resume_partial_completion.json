  "source": "import json\nfrom pathlib import Path\n\nfrom makemarket.provenance import file_sha256, receipt\n\nprotocol = Path('results/expansion/protocol-bolt-resume.json')\nentry = json.loads(protocol.read_text())['nvidia/nemotron-3.5-bolt-e4b']\ngames = {}\nfor game, count in (('dice', 138), ('cards', 39)):\n    path = Path(f'results/expansion/raw/{game}/nvidia_nemotron-3.5-bolt-e4b.jsonl')\n    rows = [json.loads(line) for line in path.read_text().splitlines()]\n    assert sorted(r['seed'] for r in rows) == list(range(200, 200 + count))\n    assert all(r['game'] == game and len(r['rounds']) == 6 for r in rows)\n    assert entry[game]['error'] == 'RuntimeError: NotFoundError(404): Error code: 404'\n    games[game] = {'episodes_saved': count, 'raw_file': str(path),\n                   'raw_sha256': file_sha256(path), 'attempt': entry[game]}\nrecord = {'provenance': receipt({'purpose': 'retain both partial Bolt cohorts and exact failures after the first conditional resume'}, 'NIM immutable deployment revision not exposed'),\n          'source': Path(__file__).read_text(), 'games': games,\n          'protocol_file': str(protocol), 'protocol_sha256': file_sha256(protocol),\n          'interpretation': 'Both games stop on intermittent HTTP 404 under the original imported fail-fast client. Do not score partial cohorts or discard successful episodes. The registered missing-only recovery uses bounded NIM 404 retry; prompts, decoder and seeds stay fixed.'}\nPath('results/expansion/bolt_resume_partial_completion.json').write_text(json.dumps(record, indent=2) + '\\n')\nprint({game: row['episodes_saved'] for game, row in games.items()})\n",
