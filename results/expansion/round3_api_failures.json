  "source": "import json\nfrom pathlib import Path\n\nfrom makemarket.provenance import file_sha256, receipt\n\nroot = Path('results/expansion')\nprotocol = json.loads((root / 'protocol-mistral-default.json').read_text())\nprobes = {}\nfor label, entry in protocol.items():\n    response = entry.get('probe', {})\n    probes[label] = {k: entry[k] for k in ('usable', 'error', 'probe_wall_seconds', 'provenance')}\n    probes[label]['response_metadata'] = {k: response.get(k) for k in ('finish_reason', 'completion_tokens', 'prompt_tokens', 'served_model', 'system_fingerprint', 'latency', 'cached')}\n    probes[label]['content_chars'] = len(response.get('content') or '')\n    probes[label]['reasoning_chars'] = len(response.get('reasoning') or '')\nultra = json.loads((root / 'protocol-ultra-medium.json').read_text())\nentry = next(iter(ultra.values()))\nraw = root / 'raw/dice/nvidia_nemotron-3-ultra-550b-a55b__thinking-medium_.jsonl'\nrows = [json.loads(s) for s in raw.read_text().splitlines()]\nassert [r['seed'] for r in rows] == list(range(200, 253))\nassert all(len(r['rounds']) == 6 and r['game'] == 'dice' for r in rows)\nrecord = {'provenance': receipt({'purpose': 'retain unsuccessful availability control and incomplete thinking cohort without scores'}),\n          'source': Path(__file__).read_text(), 'mistral_probes': probes,\n          'mistral_protocol_sha256': file_sha256(root / 'protocol-mistral-default.json'),\n          'ultra_thinking_dice': {'episodes': len(rows), 'raw_file': str(raw), 'raw_sha256': file_sha256(raw), **entry['dice']},\n          'scope': 'Availability and acquisition only. No score is computed for the incomplete 53-episode cohort. Cards acquisition remains active. Original failed probes are retained.'}\n(root / 'round3_api_failures.json').write_text(json.dumps(record, indent=2) + '\\n')\nprint('Retained failed Mistral controls and all 53 completed Ultra-thinking dice episodes; scores sealed.')\n",
